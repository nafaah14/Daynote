# Copy to .env for local development. Nothing here is needed just to run the
# app — Firebase is configured in Settings → Cloud sync, at runtime.
#
# These are only for SCHEDULED push notifications (netlify/functions).
# Generate your own with:  npx web-push generate-vapid-keys

# Public half — ships in the client bundle, which is fine.
VITE_VAPID_PUBLIC_KEY=

# Private half — server only. Set this in the Netlify UI as an environment
# variable, never in a VITE_ name and never committed. A VITE_ prefix would
# bake it into the browser bundle for anyone to read.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Firebase Admin, for the scheduled reminder function only.
FB_PROJECT_ID=
FB_CLIENT_EMAIL=
FB_PRIVATE_KEY=
